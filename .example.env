# Copy to .env.local and fill in. Generate AUTH_SECRET with: openssl rand -base64 32

AUTH_SECRET=

# Server-only backend base URL (plan §6.1/§6.4). Never prefix this with
# NEXT_PUBLIC_ -- the `server-only` import in environment-config.server.ts
# fails the build if a client bundle imports it, and the browser is never
# meant to see the real backend URL: it only ever calls same-origin
# /api/proxy/* (see src/app/api/proxy/[...path]/route.ts), which reads this
# var server-side and forwards the request. One value per deployment:
# .env.local points at this repo's own mock backend (http://localhost:3100/api/mock-backend,
# 3100 is this repo's pinned dev port -- see package.json's "dev" script);
# .env.staging / .env.production point at the real backend for that environment.
API_URL=