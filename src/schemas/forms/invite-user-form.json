{
  "id": "invite-user-form",
  "i18nNamespace": "tables.users",
  "layout": { "columns": 1 },
  "fields": [
    {
      "name": "name",
      "type": "text",
      "labelKey": "columns.name",
      "validation": { "required": true }
    },
    {
      "name": "email",
      "type": "email",
      "labelKey": "columns.email",
      "validation": { "required": true }
    },
    {
      "name": "password",
      "type": "password",
      "labelKey": "columns.password",
      "validation": { "required": true }
    }
  ],
  "actions": [
    {
      "id": "submit",
      "type": "submit",
      "labelKey": "actions.newUser",
      "variant": "primary",
      "onClick": "inviteUser",
      "onSuccess": {
        "toast": { "variant": "success", "messageKey": "toast.userInvited" },
        "refetch": true
      },
      "onError": {
        "toast": { "variant": "error", "messageKey": "toast.genericError" }
      }
    }
  ]
}
