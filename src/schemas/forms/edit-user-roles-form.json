{
  "id": "edit-user-roles-form",
  "i18nNamespace": "tables.users",
  "layout": { "columns": 1 },
  "fields": [
    {
      "name": "email",
      "type": "email",
      "labelKey": "columns.email",
      "validation": { "required": true }
    }
  ],
  "actions": [
    {
      "id": "submit",
      "type": "submit",
      "labelKey": "actions.save",
      "variant": "primary",
      "onClick": "saveEmail",
      "onSuccess": {
        "toast": { "variant": "success", "messageKey": "toast.emailUpdated" },
        "refetch": true
      },
      "onError": {
        "toast": { "variant": "error", "messageKey": "toast.genericError" }
      }
    }
  ]
}
