{
  "id": "edit-user-roles-form",
  "i18nNamespace": "tables.users",
  "layout": { "columns": 1 },
  "fields": [
    {
      "name": "role",
      "type": "select",
      "labelKey": "editRolesDialog.roleLabel",
      "validation": { "required": true },
      "optionsSource": {
        "type": "static",
        "options": [
          { "value": "viewer", "labelKey": "roles.viewer" },
          { "value": "manager", "labelKey": "roles.manager" },
          { "value": "platform-admin", "labelKey": "roles.platform-admin" }
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "submit",
      "type": "submit",
      "labelKey": "actions.save",
      "variant": "primary",
      "onClick": "saveRoles",
      "onSuccess": {
        "toast": { "variant": "success", "messageKey": "toast.rolesUpdated" },
        "refetch": true
      },
      "onError": {
        "toast": { "variant": "error", "messageKey": "toast.genericError" }
      }
    }
  ]
}
