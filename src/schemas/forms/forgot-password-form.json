{
  "id": "forgot-password-form",
  "i18nNamespace": "auth.forgotPassword",
  "layout": {
    "columns": 1
  },
  "fields": [
    {
      "name": "email",
      "type": "email",
      "labelKey": "fields.email.label",
      "placeholderKey": "fields.email.placeholder",
      "validation": {
        "required": true,
        "messages": {
          "required": "validation.emailRequired",
          "email": "validation.emailInvalid"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "submit",
      "type": "submit",
      "labelKey": "actions.sendOtp",
      "variant": "primary",
      "onClick": "sendOtp"
    }
  ]
}
