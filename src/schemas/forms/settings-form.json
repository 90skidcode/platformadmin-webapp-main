{
  "id": "settings-form",
  "i18nNamespace": "forms.settings",
  "layout": { "columns": 2 },
  "fields": [
    {
      "name": "orgName",
      "type": "text",
      "labelKey": "fields.orgName.label",
      "validation": { "required": true }
    },
    {
      "name": "defaultEnvironment",
      "type": "select",
      "labelKey": "fields.defaultEnvironment.label",
      "validation": { "required": true },
      "optionsSource": {
        "type": "static",
        "options": [
          { "value": "dev", "label": "Development" },
          { "value": "staging", "label": "Staging" },
          { "value": "production", "label": "Production" }
        ]
      }
    },
    {
      "name": "sessionTimeoutMinutes",
      "type": "number",
      "labelKey": "fields.sessionTimeoutMinutes.label",
      "validation": { "required": true, "min": 5, "max": 480 }
    },
    {
      "name": "notifyOnLogin",
      "type": "switch",
      "labelKey": "fields.notifyOnLogin.label"
    },
    {
      "name": "notifyOnRoleChange",
      "type": "switch",
      "labelKey": "fields.notifyOnRoleChange.label"
    }
  ],
  "actions": [
    {
      "id": "submit",
      "type": "submit",
      "labelKey": "actions.submit",
      "variant": "primary",
      "endpoint": { "method": "PUT", "url": "/settings" },
      "onSuccess": {
        "toast": { "variant": "success", "messageKey": "toast.settingsSaved" }
      },
      "onError": {
        "toast": { "variant": "error", "messageKey": "toast.genericError" }
      },
      "permission": "settings.write"
    }
  ]
}
