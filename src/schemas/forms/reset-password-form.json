{
  "id": "reset-password-form",
  "i18nNamespace": "auth.resetPassword",
  "layout": {
    "columns": 1
  },
  "fields": [
    {
      "name": "new_password",
      "type": "password",
      "labelKey": "fields.newPassword.label",
      "onKeyUp": "checkPasswordMatch",
      "validation": {
        "required": true,
        "minLength": 8,
        "maxLength": 13,
        "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^a-zA-Z0-9]).{8,13}$",
        "messages": {
          "required": "validation.newPasswordRequired",
          "minLength": "validation.passwordComplexity",
          "maxLength": "validation.passwordComplexity",
          "pattern": "validation.passwordComplexity"
        }
      }
    },
    {
      "name": "confirm_password",
      "type": "password",
      "labelKey": "fields.confirmPassword.label",
      "onKeyUp": "checkPasswordMatch",
      "validation": {
        "required": true,
        "minLength": 8,
        "messages": {
          "required": "validation.confirmPasswordRequired",
          "minLength": "validation.passwordComplexity",
          "maxLength": "validation.passwordComplexity"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "submit",
      "type": "submit",
      "labelKey": "actions.resetPassword",
      "variant": "primary",
      "onClick": "resetPassword"
    }
  ]
}
