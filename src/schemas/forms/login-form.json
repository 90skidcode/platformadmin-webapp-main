{
  "id": "login-form",
  "i18nNamespace": "auth.login",
  "layout": {
    "columns": 1
  },
  "fields": [
    {
      "name": "username",
      "type": "text",
      "labelKey": "fields.username.label",
      "validation": {
        "required": true
      }
    },
    {
      "name": "password",
      "type": "password",
      "labelKey": "fields.password.label",
      "validation": {
        "required": true,
        "minLength": 8
      }
    }
  ],
  "actions": [
    {
      "id": "submit",
      "type": "button",
      "labelKey": "actions.signIn",
      "variant": "primary",
      "onClick": "signInWithCredentials"
    }
  ]
}
