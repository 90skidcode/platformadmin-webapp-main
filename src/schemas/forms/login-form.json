{
  "id": "login-form",
  "i18nNamespace": "auth.login",
  "layout": {
    "columns": 1
  },
  "fields": [
    {
      "name": "email",
      "type": "email",
      "labelKey": "fields.email.label",
      "validation": {
        "required": true,
        "messages": {
          "required": "validation.emailRequired",
          "email": "validation.emailInvalid"
        }
      }
    },
    {
      "name": "password",
      "type": "password",
      "labelKey": "fields.password.label",
      "validation": {
        "required": true,
        "minLength": 8,
        "messages": {
          "required": "validation.passwordRequired",
          "minLength": "validation.passwordMinLength"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "submit",
      "type": "submit",
      "labelKey": "actions.signIn",
      "variant": "primary",
      "onClick": "signInWithCredentials"
    }
  ]
}
